# OpenSSL configuration
# Managed by Ansible role linux_crypto_policies_ubuntu

openssl_conf = openssl_init

[openssl_init]
ssl_conf = ssl_sect

[ssl_sect]
system_default = system_default_sect

[system_default_sect]
MinProtocol = {{ linux_crypto_min_tls_version }}
CipherString = {{ linux_crypto_tls12_ciphers }}
CipherSuites = {{ linux_crypto_tls13_ciphers }}
{% if linux_crypto_disable_legacy_tls | bool %}
# Disable SSLv2, SSLv3, TLS 1.0, TLS 1.1
Options = ServerPreference,PrioritizeChaCha
{% endif %}

[req]
# Key size and digest are hardening settings and always apply.
default_bits       = 4096
default_md         = sha256
{% if linux_crypto_cert_country or linux_crypto_cert_state or linux_crypto_cert_org %}
distinguished_name = req_distinguished_name
prompt             = no

[req_distinguished_name]
{% if linux_crypto_cert_country %}
C  = {{ linux_crypto_cert_country }}
{% endif %}
{% if linux_crypto_cert_state %}
ST = {{ linux_crypto_cert_state }}
{% endif %}
{% if linux_crypto_cert_org %}
O  = {{ linux_crypto_cert_org }}
{% endif %}
{% endif %}
